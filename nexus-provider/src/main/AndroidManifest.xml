<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="org.nexus.permission.CONNECT_PROVIDER"
        android:label="Connect to NEXUS Capability Provider"
        android:protectionLevel="normal" />

    <!-- Query framework hub visibility for Android 11+ -->
    <queries>
        <package android:name="org.nexus.framework" />
        <intent>
            <action android:name="org.nexus.action.BIND_HUB" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NEXUS Text Provider"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NEXUS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NEXUS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TextProviderService"
            android:exported="true"
            android:permission="org.nexus.permission.CONNECT_PROVIDER">
            <intent-filter>
                <action android:name="org.nexus.action.BIND_CAPABILITY_PROVIDER" />
            </intent-filter>
        </service>
    </application>

</manifest>
